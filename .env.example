# Multi-Provider LLM Configuration: Nebius Token Factory or Groq Cloud (Open-Source)
# Option A: Groq Cloud (Instant, free tier, no credit card required)
GROQ_API_KEY=your_groq_api_key_here

# Option B: Nebius Token Factory (NVIDIA Nemotron 3 Nano, Super, Ultra)
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_API_KEY=your_nebius_api_key_here

# SEC EDGAR Ingestion Configuration
# Required format: Sample Company Name AdminContact@<sample company domain>.com
SEC_USER_AGENT=ALBUS-QuantResearchCopilot/1.0 (researcher@example.com)

# Optional Configuration
LLM_CACHE_DIR=.cache/llm
STREAMLIT_SERVER_PORT=8501
DEMO_MODE=false
