# Nebius Token Factory API Configuration
# Base URL for OpenAI-compatible endpoint on Nebius Token Factory
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.ai/v1
NEBIUS_API_KEY=your_nebius_api_key_here

# SEC EDGAR Ingestion Configuration
# Required format: Sample Company Name AdminContact@<sample company domain>.com
EDGAR_USER_AGENT=QuantResearchCopilot/1.0 (researcher@example.com)

# Optional Configuration
LLM_CACHE_DIR=.cache/llm
STREAMLIT_SERVER_PORT=8501
DEMO_MODE=false
